    "axios": "^1.18.1",
    "element-plus": "^2.14.3",
    "lodash": "^4.18.1",
    "min-dash": "^5.1.0",
    "monaco-editor": "^0.53.0",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "^6.15.3",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
