# 变量必须以 VITE_ 为前缀才能暴露给外部读取
# 开发环境
VITE_USER_NODE_ENV='development'
# 项目信息
VITE_APP_PORT=3000
VITE_APP_TITLE=xht-cloud-admin-ui
VITE_APP_AUTHOR='小糊涂 (xht)'
# 后端管理gateWay接口地址
VITE_GATEWAY_API=http://localhost:8082
# API基础路径(反向代理)
VITE_BASE_API='/api'
# 鉴权服务前缀
VITE_AUTH_API_PREFIX=/api/auth
# 后端管理服务前缀
VITE_ADMIN_API_PREFIX=/api/admin
# 代码生成器服务前缀
VITE_GENERATE_API_PREFIX=/api/generate